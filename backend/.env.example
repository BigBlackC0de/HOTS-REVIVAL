# Copier en .env puis adapter.
HOTS_DATABASE_URL=postgresql+psycopg://hots:hots@localhost:5432/hots_revival
# Dossier des replays (auto-détecté sous Documents\Heroes of the Storm\Accounts si vide)
HOTS_REPLAY_DIR=C:\Users\azsra\Documents\Heroes of the Storm\Accounts\137044993\2-Hero-1-1278570\Replays\Multiplayer
# Identité du joueur (le toon handle est déduit du chemin si absent)
HOTS_PLAYER_BATTLETAG=
HOTS_PLAYER_TOON_HANDLE=2-Hero-1-1278570
HOTS_WATCH_REPLAYS=true
HOTS_WATCH_LIVE=true

# Claude (coach IA). Sans clé, le coach renvoie une analyse déterministe.
ANTHROPIC_API_KEY=
HOTS_CLAUDE_MODEL=claude-opus-5-5
HOTS_CLAUDE_EFFORT=medium

# Observabilité (opt-in)
HOTS_SENTRY_DSN=
HOTS_POSTHOG_KEY=
HOTS_POSTHOG_HOST=https://eu.i.posthog.com
